{
  "keymap": {
    "undo": "Mod-z",
    "redo": "Mod-Shift-z",
    "blocktype.paragraph": "Mod-0",
    "blocktype.heading1": "Mod-1",
    "blocktype.heading2": "Mod-2",
    "blocktype.heading3": "Mod-3",
    "blocktype.heading4": "Mod-4",
    "blocktype.heading5": "Mod-5",
    "blocktype.heading6": "Mod-6",
    "blocktype.bullet_list": "Mod-8",
    "blocktype.ordered_list": "Mod-9",
    "insert.horizontal_rule": "Mod-h",
    "insert.image": "Mod-Alt-i",
    "insert.table": "Mod-t",
    "insert.page_break": "Mod-Enter",
    "format.indent": "Tab",
    "format.unindent": "Shift-Tab",
    "format.bold": "Mod-b",
    "format.italic": "Mod-i",
    "format.code": "Mod-e",
    "format.link": "Mod-k",
    "format.blockquote": "Mod-g",
    "file.new": "Mod-n",
    "file.save": "Mod-s",
    "file.save_as": "Mod-Shift-s",
    "file.open": "Mod-o",
    "export.pdf": "Mod-Alt-p",
    "export.docx": "Mod-Alt-w",
    "theme.cycle": "Mod-Alt-t",
    "language.choose": "Mod-Alt-l",
    "spellcheck.toggle": "Mod-Alt-s",
    "spellcheck.next": "Mod-Alt-n",
    "spellcheck.previous": "Mod-Alt-Shift-n",
    "menu.context": "Shift-F10",
    "page.setup": "Mod-Alt-u",
    "edit.header": "Mod-Alt-h",
    "edit.footer": "Mod-Alt-f",
    "view.pages": "Mod-Alt-v"
  },
  "autocorrect": {
    "arrows": true,
    "dashes": true,
    "symbols": true,
    "formatting": true,
    "links": true,
    "quotes": true,
    "capitalize": true,
    "blocks": true,
    "replace": {
      "*": {}
    }
  },
  "spellcheck": {
    "ignoreUppercase": true,
    "ignoreWordsWithNumbers": true
  },
  "editor": {
    "indentSize": 4
  },
  "layout": {
    "page": {
      "size": "auto",
      "orientation": "portrait",
      "margins": "2.5cm"
    }
  }
}
