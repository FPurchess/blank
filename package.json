{
  "name": "blank",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Blank is a minimalist, opinionated markdown editor made for writing - keyboard-first with PDF-Export, available for Linux, macOS and Windows",
  "license": "AGPL-3.0-only",
  "maintainers": [
    {
      "name": "Florian Purchess",
      "email": "florian.purchess@googlemail.com",
      "web": "https://florian-purchess.de/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/FPurchess/blank.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "snap": "tauri build --bundles deb && cp \"$(ls -t src-tauri/target/release/bundle/deb/blank_*_amd64.deb | head -1)\" blank.deb && snapcraft pack",
    "lint": "eslint src && vue-tsc",
    "lint:fix": "eslint --fix src && vue-tsc",
    "format": "prettier --write --end-of-line=auto \"./**/*.{cjs,js,jsx,ts,tsx,vue,html,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check --end-of-line=auto \"./**/*.{cjs,js,jsx,ts,tsx,vue,html,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "dictionaries:update": "bun scripts/build-dictionary-catalog.ts",
    "engine:build": "bash scripts/build-engine.sh",
    "notices": "bun scripts/build-notices.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "vite build && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:e2e": "cd e2e && bun run test",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "docs:screenshots": "bash scripts/docs-shots.sh",
    "docs:shot": "bash scripts/docs-shots.sh --grep",
    "prepare": "husky"
  },
  "resolutions": {
    "w3c-keyname": "2.2.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "docx": "9.7.2",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "mammoth": "^1.12.3",
    "markdown-it": "^15.0.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "sass-embedded": "^1.105.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
