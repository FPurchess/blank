{
  "name": "blank",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Blank is a minimalist, opinionated markdown editor made for writing - purely keyboard-based with PDF-Export, available for Linux, macOS and Windows",
  "license": "AGPL-3.0-only",
  "maintainers": [
    {
      "name": "Florian Purchess",
      "email": "florian.purchess@googlemail.com",
      "web": "https://florian-purchess.de/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/FPurchess/blank.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src && tsc",
    "lint:fix": "eslint --fix src && tsc",
    "format": "prettier --write --end-of-line=auto \"./**/*.{cjs,js,jsx,ts,tsx,html,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check --end-of-line=auto \"./**/*.{cjs,js,jsx,ts,tsx,html,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "fonts:vfs": "bun scripts/build-pdf-vfs.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cd e2e && bun run test",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "docs:screenshots": "cd e2e && bun run screenshots",
    "prepare": "husky"
  },
  "resolutions": {
    "w3c-keyname": "2.2.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "docx": "9.7.2",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "markdown-it": "^15.0.2",
    "observable.ts": "^1.0.1",
    "pdfmake": "^0.3.11",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/pdfmake": "^0.3.3",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.9",
    "sass-embedded": "^1.105.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
