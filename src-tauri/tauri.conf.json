{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blank",
  "version": "3.0.0",
  "identifier": "com.github.fpurchess.blank",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blank",
        "width": 800,
        "height": 600,
        "decorations": true,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "cli": {
      "description": "Blank is a minimalist, opinionated markdown editor made for writing",
      "args": [
        {
          "name": "path",
          "description": "The files to open, each in a tab",
          "index": 1,
          "takesValue": true,
          "multiple": true,
          "required": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["docx"],
        "name": "Word document",
        "description": "Word document, which Blank imports",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "contentTypes": ["org.openxmlformats.wordprocessingml.document"]
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/blank.desktop",
        "files": {
          "/usr/share/metainfo/io.github.fpurchess.blank.metainfo.xml": "linux/io.github.fpurchess.blank.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/blank.desktop",
        "files": {
          "/usr/share/metainfo/io.github.fpurchess.blank.metainfo.xml": "linux/io.github.fpurchess.blank.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.fpurchess.blank.metainfo.xml": "linux/io.github.fpurchess.blank.metainfo.xml"
        }
      }
    }
  }
}
