      <image>https://raw.githubusercontent.com/FPurchess/blank/478f12e9f7f4afda52f944eed278867a952fcbce/docs/public/screenshots/theme-light.png</image>
      <caption>Writing in the light theme</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/FPurchess/blank/478f12e9f7f4afda52f944eed278867a952fcbce/docs/public/screenshots/theme-dark.png</image>
      <caption>The dark theme</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/FPurchess/blank/478f12e9f7f4afda52f944eed278867a952fcbce/docs/public/screenshots/language.png</image>
      <caption>Choosing the language for autocorrect</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="2.0.0" date="2026-09-25">
      <url type="details">https://github.com/FPurchess/blank/releases/tag/v2.0.0</url>
      <description>
        <p>Autocorrect works anywhere in the text in 14 languages, with a language chooser. Blank now uses IBM Plex Sans in the editor and the PDF, adds a link dialog, and comes with themes.</p>
      </description>
    </release>
  </releases>
</component>
